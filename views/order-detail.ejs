<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details | GardenRich</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-zinc-50 font-sans antialiased text-zinc-900">
    <%- include("partials/header") %>

    <div class="max-w-2xl mx-auto py-12 px-6 pb-24">

        <a href="/my-orders" class="inline-flex items-center text-sm font-bold text-zinc-400 hover:text-green-600 transition-colors mb-6">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Back to Orders
        </a>

        <!-- Status & Date -->
        <div class="bg-white rounded-2xl border border-zinc-100 shadow-sm p-6 mb-4">
            <div class="flex items-center justify-between mb-4">
                <span class="inline-block text-xs font-black px-4 py-2 rounded-full
                    <%= order.status === 'pending' ? 'bg-yellow-100 text-yellow-700' :
                        order.status === 'confirmed' ? 'bg-blue-100 text-blue-700' :
                        order.status === 'shipped' ? 'bg-purple-100 text-purple-700' :
                        order.status === 'delivered' ? 'bg-green-100 text-green-700' :
                        order.status === 'cancelled' ? 'bg-red-100 text-red-700' :
                        'bg-zinc-100 text-zinc-700' %>">
                    <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                </span>
                <p class="text-xs text-zinc-400 font-bold">
                    <%= new Date(order.created_at).toLocaleString('en-IN', { dateStyle: 'long', timeStyle: 'short' }) %>
                </p>
            </div>

            <!-- Progress Bar -->
            <% if (order.status !== 'cancelled') { %>
            <div class="flex items-center justify-between relative mt-6">
                <div class="absolute left-0 right-0 top-3 h-0.5 bg-zinc-100 z-0"></div>
                <div class="absolute left-0 top-3 h-0.5 bg-green-500 z-0 transition-all"
                    style="width:
                        <%= order.status === 'pending' ? '0%' :
                            order.status === 'confirmed' ? '33%' :
                            order.status === 'shipped' ? '66%' :
                            order.status === 'delivered' ? '100%' : '0%' %>">
                </div>
                <% ['Pending', 'Confirmed', 'Shipped', 'Delivered'].forEach((step, i) => {
                    const steps = ['pending', 'confirmed', 'shipped', 'delivered'];
                    const currentIndex = steps.indexOf(order.status);
                    const isCompleted = i <= currentIndex;
                %>
                <div class="flex flex-col items-center z-10">
                    <div class="w-6 h-6 rounded-full flex items-center justify-center
                        <%= isCompleted ? 'bg-green-500 text-white' : 'bg-zinc-100 text-zinc-400' %>">
                        <% if (isCompleted) { %>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                        </svg>
                        <% } %>
                    </div>
                    <p class="text-[10px] font-bold mt-1 <%= isCompleted ? 'text-green-600' : 'text-zinc-400' %>"><%= step %></p>
                </div>
                <% }) %>
            </div>
            <% } %>
        </div>

        <!-- Items -->
        <div class="bg-white rounded-2xl border border-zinc-100 shadow-sm p-6 mb-4">
            <p class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-4">Items Ordered</p>
            <div class="space-y-4">
                <% order.order_items.forEach(item => { %>
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 rounded-xl overflow-hidden bg-zinc-100 shrink-0">
                        <img src="<%= item.product_image %>" class="w-full h-full object-cover">
                    </div>
                    <div class="flex-1">
                        <p class="font-bold text-zinc-800"><%= item.product_name %></p>
                        <p class="text-sm text-zinc-400">Qty: <%= item.quantity %> × Rs. <%= item.price %></p>
                    </div>
                    <span class="font-black text-zinc-900">Rs. <%= item.price * item.quantity %></span>
                </div>
                <% }) %>
            </div>
            <div class="border-t border-zinc-100 mt-4 pt-4 flex justify-between">
                <span class="font-black text-zinc-900">Total</span>
                <span class="font-black text-green-700 text-lg">Rs. <%= order.total %></span>
            </div>
        </div>

        <!-- Delivery Address -->
        <div class="bg-white rounded-2xl border border-zinc-100 shadow-sm p-6 mb-4">
            <p class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-3">Delivering To</p>
            <p class="font-bold text-zinc-800"><%= order.addresses?.first_name %> <%= order.addresses?.last_name %></p>
            <p class="text-sm text-zinc-500 mt-1"><%= order.addresses?.address %></p>
            <p class="text-sm text-zinc-500"><%= order.addresses?.city %> — <%= order.addresses?.pin_code %></p>
            <p class="text-sm text-zinc-500 mt-1"><%= order.addresses?.phone %></p>
        </div>

        <!-- Payment -->
        <div class="bg-white rounded-2xl border border-zinc-100 shadow-sm p-6">
            <p class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-3">Payment</p>
            <div class="flex items-center justify-between">
                <span class="font-bold text-zinc-700">Cash On Delivery</span>
                <span class="text-xs font-black px-3 py-1 rounded-full bg-yellow-100 text-yellow-700">COD</span>
            </div>
        </div>

    </div>

    <%- include("partials/footer") %>
</body>
</html>