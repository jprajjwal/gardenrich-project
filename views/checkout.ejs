<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Checkout | GardenRich</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-zinc-50 font-sans antialiased text-zinc-900">
    <%- include("partials/header") %>

    <div class="max-w-7xl mx-auto py-12 px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row gap-12">
            
            <div class="flex-1 space-y-8">
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-zinc-100">
                    <div class="flex items-center mb-6">
                        <span class="w-8 h-8 bg-zinc-900 text-white rounded-full flex items-center justify-center font-bold mr-3 text-sm">1</span>
                        <h2 class="text-xl font-bold">Contact Information</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <input type="email" placeholder="Email Address" class="w-full p-4 rounded-xl border border-zinc-200 focus:border-green-600 outline-none transition-all">
                        <input type="tel" placeholder="Phone Number" class="w-full p-4 rounded-xl border border-zinc-200 focus:border-green-600 outline-none transition-all">
                    </div>
                </div>

                <div class="bg-white p-8 rounded-3xl shadow-sm border border-zinc-100">
                    <div class="flex items-center mb-6">
                        <span class="w-8 h-8 bg-zinc-900 text-white rounded-full flex items-center justify-center font-bold mr-3 text-sm">2</span>
                        <h2 class="text-xl font-bold">Shipping Address</h2>
                    </div>
                    <div class="space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <input type="text" placeholder="First Name" class="p-4 rounded-xl border border-zinc-200 outline-none">
                            <input type="text" placeholder="Last Name" class="p-4 rounded-xl border border-zinc-200 outline-none">
                        </div>
                        <input type="text" placeholder="Address (House No, Building, Street)" class="w-full p-4 rounded-xl border border-zinc-200 outline-none">
                        <div class="grid grid-cols-2 gap-4">
                            <input type="text" placeholder="City" class="p-4 rounded-xl border border-zinc-200 outline-none">
                            <input type="text" placeholder="PIN Code" class="p-4 rounded-xl border border-zinc-200 outline-none">
                        </div>
                    </div>
                </div>

                <div class="bg-white p-8 rounded-3xl shadow-sm border border-zinc-100">
                    <div class="flex items-center mb-6">
                        <span class="w-8 h-8 bg-zinc-900 text-white rounded-full flex items-center justify-center font-bold mr-3 text-sm">3</span>
                        <h2 class="text-xl font-bold">Payment Method</h2>
                    </div>
                    <div class="space-y-3">
                        <label class="flex items-center p-4 rounded-xl border border-zinc-100 bg-zinc-200 opacity-50 cursor-not-allowed">
                            <input type="radio" name="payment" disabled class="w-4 h-4 accent-green-600">
                            <span class="ml-3 font-bold text-zinc-700">Online Payment (Coming Soon)</span>
                        </label>
                        <label class="flex items-center p-4 rounded-xl border-2 border-green-600 bg-green-50 cursor-pointer">
                            <input type="radio" name="payment" checked class="w-4 h-4 accent-green-600">
                            <span class="ml-3 font-bold text-green-900">Cash On Delivery (COD)</span>
                        </label>
                    </div>
                </div>

                <button class="w-full py-5 bg-green-600 hover:bg-green-700 text-white font-black rounded-2xl shadow-lg transition-all active:scale-95 uppercase tracking-widest">
                    Place Order Now
                </button>
            </div>

            <div class="lg:w-96">
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-zinc-100 sticky top-24">
                    <h2 class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-6">Order Review</h2>
                    
                    <div class="space-y-4 mb-8">
                        <div class="flex gap-4">
                            <div class="w-16 h-16 bg-zinc-100 rounded-lg overflow-hidden shrink-0">
                                <img src="/images/atta.webp" class="w-full h-full object-cover">
                            </div>
                            <div class="flex-1">
                                <h4 class="text-sm font-bold text-zinc-800 leading-tight">Pure Organic Atta</h4>
                                <p class="text-[10px] text-zinc-400 font-bold">Qty: 1</p>
                            </div>
                            <span class="text-sm font-black">Rs. 160</span>
                        </div>
                    </div>

                    <div class="border-t border-zinc-50 pt-4 space-y-2">
                        <div class="flex justify-between text-sm text-zinc-500 font-medium">
                            <span>Subtotal</span>
                            <span>Rs. 160.00</span>
                        </div>
                        <div class="flex justify-between text-sm text-red-500 font-medium">
                            <span>Discount</span>
                            <span>- Rs. 0.00</span>
                        </div>
                        <div class="flex justify-between pt-4 border-t border-zinc-100">
                            <span class="font-bold">To Pay</span>
                            <span class="text-xl font-black text-green-700">Rs. 160.00</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <%- include("partials/footer") %>
</body>
</html>